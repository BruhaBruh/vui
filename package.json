{
	"name": "@bruhabruh/vui",
	"type": "module",
	"version": "0.2.1",
	"packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977",
	"description": "BruhaBruh UI Library",
	"author": "BruhaBruh",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/bruhabruh/vui"
	},
	"keywords": [],
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/lib/index.d.ts",
			"import": "./dist/lib/index.js"
		}
	},
	"main": "./dist/lib/index.js",
	"module": "./dist/lib/index.js",
	"types": "./dist/lib/index.d.ts",
	"bin": "./dist/index.js",
	"scripts": {
		"build": "run-s build:cli build:lib type-check",
		"build-only": "vite build",
		"build:cli": "tsup",
		"build:lib": "vite build --config vite.lib.config.ts && pnpm exec vue-tsc --project tsconfig.lib.json",
		"cli": "tsx ./src/cli/client/index.ts",
		"dev": "vite",
		"generate:config-schema": "tsx ./src/cli/generate/index.ts config-schema",
		"generate:registry": "tsx ./src/cli/generate/index.ts registry",
		"generate:registry-schema": "tsx ./src/cli/generate/index.ts registry-schema",
		"generate:theme": "pnpm dlx @bruhabruh/theme@latest generate",
		"lint": "eslint .",
		"preview": "vite preview",
		"type-check": "vue-tsc --build"
	},
	"peerDependencies": {
		"vue": "^3.5.0"
	},
	"dependencies": {
		"@floating-ui/vue": "^2.0.0",
		"@iconify/vue": "^5.0.1",
		"@vueuse/core": "^14.3.0",
		"@vueuse/integrations": "^14.3.0",
		"class-variance-authority": "^0.7.1",
		"embla-carousel": "8.6.0",
		"embla-carousel-vue": "^8.6.0",
		"focus-trap": "^8.2.2",
		"motion-v": "2.3.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-merge-vue-directive": "^2.0.5"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.0.0",
		"@antfu/ni": "^30.1.0",
		"@bruhabruh/type-safe": "^1.3.0",
		"@iconify/vue": "^5.0.1",
		"@tailwindcss/vite": "^4.3.1",
		"@tsconfig/node22": "^22.0.5",
		"@types/node": "^26.0.0",
		"@types/prompts": "^2.4.9",
		"@vitejs/plugin-vue": "^6.0.7",
		"@vue/tsconfig": "^0.9.1",
		"@vue/typescript-plugin": "^3.3.5",
		"commander": "^15.0.0",
		"eslint": "^10.5.0",
		"eslint-plugin-format": "^2.0.1",
		"jiti": "^2.7.0",
		"kleur": "^4.1.5",
		"npm-run-all2": "^9.0.2",
		"ora": "^9.4.1",
		"prompts": "^2.4.2",
		"shiki": "^4.2.0",
		"tailwindcss": "^4.3.1",
		"tsup": "^8.5.1",
		"tsx": "^4.22.4",
		"typescript": "~6.0.3",
		"vite": "^8.0.16",
		"vite-plugin-dts": "^5.0.2",
		"vite-plugin-vue-devtools": "^8.1.3",
		"vue": "^3.5.38",
		"vue-router": "^5.1.0",
		"vue-tsc": "^3.3.5",
		"zod": "4.4.3"
	}
}
